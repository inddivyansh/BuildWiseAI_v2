# ==============================================================================
# BuildWise v2 — Git Exclusions
# ==============================================================================

# --- Environment & Credentials ------------------------------------------------
.env
.env.*
!.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
*.p12

# --- Python & Virtual Environments -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Envs
.venv/
venv/
ENV/
env/
.uv/

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Node & Frontend Build ----------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Machine Learning Weights & Large Model Checkpoints -----------------------
# Exclude heavy binary checkpoint downloads; retain helper scripts and metadata
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
ml/models/**/checkpoints/*
!ml/models/**/checkpoints/.gitkeep
ml/models/housediffusion/repo/
ml/models/gsdiff/repo/

# --- Runtime Data, Temporary Uploads & Storage --------------------------------
data/
NBC/
storage/uploads/*
!storage/uploads/.gitkeep
tmp/
/tmp/archigen/
*.sqlite
*.sqlite3
*.db-journal

# --- Tooling & IDE ------------------------------------------------------------
.playwright-mcp/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Documentation Assets (Keep All Docs Images & SVGs) -----------------------
!docs/**/*
