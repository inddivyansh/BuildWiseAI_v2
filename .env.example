# ==============================================================================
# BuildwiseAI Unified AEC Platform Environment Configuration
# ==============================================================================

# --- Server & CORS Settings ---------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=true

# --- PlanLint LLM Access (Bring your own key; pick ONE or several) -------------
# PlanLint uses Pydantic AI (OpenAI, Google, Anthropic, Mistral, Ollama).
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Model strings: openai:gpt-5.6-sol | google:gemini-3.6-flash | anthropic:claude-sonnet-5
PLANLINT_VISION_MODEL=openai:gpt-5.6-sol
PLANLINT_TEXT_MODEL=openai:gpt-5.6-sol

# Parser mode: auto (LLM-first) | docling | simple | llm
PLANLINT_SEMANTIC_PARSER=auto

# Offline sample mode: swaps LLM calls for deterministic label/regex extraction
# so the bundled ADA clearance sample runs with zero API cost and no key.
PLANLINT_OFFLINE_SAMPLE=0

# Docling memory tuning: pages per conversion chunk (2 pages ≈ 6.5 GB peak commit)
PLANLINT_DOCLING_PAGE_CHUNK=2

# --- ArchiGen Floor Plan Generation & Zoning Settings -------------------------
LLM_PROVIDER=gemini  # gemini | ollama | sglang
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite-preview
DEFAULT_GENERATOR=housediffusion  # housediffusion | gsdiff | chathousediffusion

# Modal Labs (optional remote GPU execution for HouseDiffusion / CubiCasa)
MODAL_APP_NAME=archigen-housediffusion
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Local weights / repo paths (for local GPU/CPU execution)
HOUSEDIFF_WEIGHTS_PATH=ml/models/housediffusion/repo/checkpoints/model250000.pt
HOUSEDIFF_REPO_PATH=ml/models/housediffusion/repo

# Generation-time zoning compliance (Municipal regulations)
COMPLIANCE_ENABLED=true
BUILDING_CODES_PATH=data/building_codes/quebec
LANCEDB_PATH=data/building_codes/lancedb

# Floor plan ingestion limits
MAX_UPLOAD_SIZE_MB=50
DEFAULT_SCALE_M_PER_PIXEL=0.01

# --- Neo4j Graph Database (Durable projects, blueprints, documents, audits) ---
# Use 127.0.0.1, not localhost (avoids ~21s IPv6 timeout delay on Windows)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=planlint123

# --- Supabase & Multi-Tenant Authentication -----------------------------------
# Required for user-specific data isolation and JWT verification.
# In local development without cloud Supabase, leaving these blank activates
# deterministic demo authentication mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Frontend Next.js Configuration -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

