# ==============================================================================
# BuildwiseAI Unified AEC Platform Environment Configuration
# ==============================================================================

# --- Server & CORS Settings ---------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=true

# ==============================================================================
# AI PROVIDERS & FREE-TIER MODELS
# ==============================================================================
# BuildWise v2 supports multiple AI providers, prioritizing free-tier APIs.
# Configure at least ONE free-tier provider below (or use local Ollama with zero keys).

# Active Default Model & Provider
# Options for LLM_PROVIDER: gemini | groq | xai | ollama | sglang
LLM_PROVIDER=gemini
# Options for LLM_MODEL (Selectable Free Tier):
#   - gemini-3.5-flash (Recommended default — active free tier)
#   - gemini-3.8-flash
#   - gemini-2.5-flash (auto-mapped to 3.5)
#   - qwen-2.5-32b (via Groq)
#   - grok-beta (via xAI)
#   - ollama:qwen2.5 (Local, no key required)
#   - ollama:llama3.2 (Local, no key required)
LLM_MODEL=gemini-3.5-flash

# --- 1. Google Gemini (Free Tier) ---------------------------------------------
# Get a free API key at: https://aistudio.google.com/app/apikey
# Free tier limits: 15 RPM (requests/min), 1,500 RPD (requests/day), 1M TPM. Zero cost.
# (Both GEMINI_API_KEY and GOOGLE_API_KEY are recognized)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- 2. Groq Cloud (Free Tier hosting Qwen 2.5 & Llama) -----------------------
# Get a free API key at: https://console.groq.com/keys
# Free tier limits: 30 RPM, 14,400 RPD, ultra-fast LPU hardware inference (~500+ tokens/s).
# Models: qwen-2.5-32b, qwen-2.5-coder-32b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 3. xAI Grok (Developer Free Quota / Credits) ----------------------------
# Get an API key at: https://console.x.ai
# Models: grok-beta
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# --- 4. Ollama (100% Local, Offline & Zero Cost) ------------------------------
# Download Ollama at: https://ollama.com
# Pull a model: `ollama run qwen2.5`
# No API key required; runs locally on your computer.
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# PREMIUM AI PROVIDERS — COMING SOON
# ==============================================================================
# Integrations are preserved in the backend codebase, but marked "Coming Soon"
# and disabled from selection in the current free-tier release.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PlanLint LLM Access & Verification Engine --------------------------------
# Pydantic AI model strings for regulatory legal clause parsing & OCR verification
PLANLINT_VISION_MODEL=google:gemini-3.5-flash
PLANLINT_TEXT_MODEL=google:gemini-3.5-flash

# Parser mode: auto (LLM-first) | docling | simple | llm
PLANLINT_SEMANTIC_PARSER=auto

# Offline sample mode: swaps LLM calls for deterministic label/regex extraction
# so the bundled ADA clearance sample runs with zero API cost and no key.
PLANLINT_OFFLINE_SAMPLE=0

# Docling memory tuning: pages per conversion chunk (2 pages ≈ 6.5 GB peak commit)
PLANLINT_DOCLING_PAGE_CHUNK=2

# --- ArchiGen Floor Plan Generation & Zoning Settings -------------------------
DEFAULT_GENERATOR=housediffusion  # housediffusion | gsdiff | chathousediffusion | constraint_solver

# Modal Labs (optional remote GPU execution for HouseDiffusion / CubiCasa)
MODAL_APP_NAME=archigen-housediffusion
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Local weights / repo paths (for local GPU/CPU execution)
HOUSEDIFF_WEIGHTS_PATH=ml/models/housediffusion/repo/checkpoints/model250000.pt
HOUSEDIFF_REPO_PATH=ml/models/housediffusion/repo

# Generation-time zoning compliance (Municipal regulations)
COMPLIANCE_ENABLED=true
BUILDING_CODES_PATH=data/building_codes/quebec
LANCEDB_PATH=data/building_codes/lancedb

# Floor plan ingestion limits
MAX_UPLOAD_SIZE_MB=50
DEFAULT_SCALE_M_PER_PIXEL=0.01

# --- Neo4j Graph Database (Durable projects, blueprints, documents, audits) ---
# Use 127.0.0.1, not localhost (avoids ~21s IPv6 timeout delay on Windows)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=planlint123

# --- Supabase & Multi-Tenant Authentication -----------------------------------
# Required for user-specific data isolation and JWT verification.
# In local development without cloud Supabase, leaving these blank activates
# deterministic demo authentication mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Frontend Next.js Configuration -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=